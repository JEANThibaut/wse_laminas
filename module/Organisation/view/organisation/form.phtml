    <form method="post" action="<?= $this->escapeHtmlAttr($action) ?>">
        <div class="mb-3">
            <label for="title" class="form-label fw-semibold"><?= $type === Post::TYPE_POLL ? 'Question' : 'Titre' ?></label>
            <input type="text" class="form-control" id="title" name="title" required minlength="3" maxlength="<?= Post::TITLE_MAX ?>" value="<?= $this->escapeHtmlAttr($values['title']) ?>">
        </div>

        <?php if ($type === Post::TYPE_EVENT): ?>
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-6">
                    <label for="starts_at" class="form-label fw-semibold">Début</label>
                    <input type="datetime-local" class="form-control" id="starts_at" name="starts_at" required value="<?= $this->escapeHtmlAttr($values['starts_at']) ?>">
                </div>
                <div class="col-12 col-md-6">
                    <label for="ends_at" class="form-label">Fin <small class="text-muted">(facultatif)</small></label>
                    <input type="datetime-local" class="form-control" id="ends_at" name="ends_at" value="<?= $this->escapeHtmlAttr($values['ends_at']) ?>">
                </div>
                <div class="col-12">
                    <label for="location" class="form-label">Lieu <small class="text-muted">(facultatif)</small></label>
                    <input type="text" class="form-control" id="location" name="location" maxlength="<?= Post::LOCATION_MAX ?>" value="<?= $this->escapeHtmlAttr($values['location']) ?>">
                </div>
            </div>
        <?php endif; ?>

        <div class="mb-3">
            <label for="body" class="form-label <?= $type === Post::TYPE_MESSAGE ? 'fw-semibold' : '' ?>">
                <?= $type === Post::TYPE_MESSAGE ? 'Message' : 'Détails <small class="text-muted">(facultatif)</small>' ?>
            </label>
            <textarea class="form-control" id="body" name="body" rows="<?= $type === Post::TYPE_MESSAGE ? 8 : 4 ?>" maxlength="<?= Post::BODY_MAX ?>"
                      <?= $type === Post::TYPE_MESSAGE ? 'required' : '' ?>><?= $this->escapeHtml($values['body']) ?></textarea>
        </div>

        <?php if ($type === Post::TYPE_POLL): ?>
            <div class="mb-3">
                <div class="form-label fw-semibold mb-1">Choix</div>
                <?php if ($optionsLocked): ?>
                    <div class="alert alert-secondary small py-2">Des membres ont déjà voté : les choix ne peuvent plus être modifiés.</div>
                    <ul class="small">
                        <?php foreach ($values['options'] as $label): ?><li><?= $this->escapeHtml($label) ?></li><?php endforeach; ?>
                    </ul>
                <?php else: ?>
                    <div id="pollOptions">
                        <?php foreach ($values['options'] as $label): ?>
                            <input type="text" class="form-control mb-2" name="options[]" maxlength="<?= PollOption::LABEL_MAX ?>" value="<?= $this->escapeHtmlAttr($label) ?>" placeholder="Choix">
                        <?php endforeach; ?>
                    </div>
                    <div class="d-flex flex-wrap" style="gap: .5rem;">
                        <button type="button" class="btn btn-sm btn-light" id="addOption"><i class="fa-solid fa-plus me-1"></i>Ajouter un choix</button>
                        <button type="button" class="btn btn-sm btn-light" id="yesNo">Oui / Non</button>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="multiple" name="multiple" value="1" <?= $values['multiple'] ? 'checked' : '' ?>>
                        <label class="form-check-label" for="multiple">Plusieurs choix possibles</label>
                    </div>
                <?php endif; ?>
            </div>
        <?php endif; ?>

        <?php if ($type !== Post::TYPE_MESSAGE): ?>
            <div class="mb-3">
                <label for="closes_at" class="form-label">Réponses jusqu'au <small class="text-muted">(facultatif<?= $type === Post::TYPE_EVENT ? ' : par défaut, le début de l’événement' : '' ?>)</small></label>
                <input type="datetime-local" class="form-control" id="closes_at" name="closes_at" style="max-width: 16rem;" value="<?= $this->escapeHtmlAttr($values['closes_at']) ?>">
            </div>
        <?php endif; ?>

        <?php if ($isNew): ?>
