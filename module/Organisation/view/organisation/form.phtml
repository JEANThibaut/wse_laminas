$titles = [Post::TYPE_MESSAGE => 'un message', Post::TYPE_POLL => 'un sondage', Post::TYPE_EVENT => 'un événement'];
?>
<?= $this->partial('organisation/partial/header', ['active' => '', 'canEdit' => true]) ?>

<div class="card">
    <h5 class="mb-3"><?= $isNew ? 'Publier ' . $titles[$type] : 'Modifier ' . $titles[$type] ?></h5>

    <?php if ($errors): ?>
        <div class="alert alert-danger py-2">
