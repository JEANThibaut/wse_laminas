                <input class="form-check-input" type="checkbox" id="notify" name="notify" value="1" checked>
                <label class="form-check-label" for="notify">
                    <i class="fa-solid fa-bell me-1"></i>Prévenir les membres par notification
                    <small class="d-block text-muted">Ceux qui ont installé l'application et activé les notifications « Organisation ».</small>
                </label>
            </div>
        <?php endif; ?>

        <div class="d-flex flex-wrap" style="gap: .5rem;">
            <button type="submit" class="btn btn-success"><?= $isNew ? 'Publier' : 'Enregistrer' ?></button>
            <a href="<?= $this->escapeHtmlAttr($isNew ? $this->url('organisation') : $this->url('organisation-view', ['id' => $post->getId()])) ?>" class="btn btn-light">Annuler</a>
        </div>
    </form>
</div>

<?php if ($type === Post::TYPE_POLL && !$optionsLocked): ?>
<script>
    (function () {
        var list = document.getElementById('pollOptions');
        var max = <?= OrganisationManager::OPTIONS_MAX ?>;
        function addOption(value) {
            if (list.children.length >= max) { return; }
            var input = document.createElement('input');
            input.type = 'text';
            input.name = 'options[]';
            input.className = 'form-control mb-2';
            input.maxLength = <?= PollOption::LABEL_MAX ?>;
            input.placeholder = 'Choix';
            input.value = value || '';
            list.appendChild(input);
            return input;
        }
        document.getElementById('addOption').addEventListener('click', function () {
            var input = addOption('');
            if (input) { input.focus(); }
        });
        // Sondage oui / non : remplace les choix par "Oui" et "Non"
        document.getElementById('yesNo').addEventListener('click', function () {
            list.innerHTML = '';
            addOption('Oui');
            addOption('Non');
            document.getElementById('multiple').checked = false;
        });
    })();
</script>
<?php endif; ?>
