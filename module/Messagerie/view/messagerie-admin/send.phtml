<script>
    (function () {
        var audience = document.getElementById('audience');
        var one = document.getElementById('oneUser');
        function toggle() { one.style.display = audience.value === '<?= MessagerieManager::AUDIENCE_ONE ?>' ? '' : 'none'; }
        audience.addEventListener('change', toggle);
        toggle();
    })();
</script>
