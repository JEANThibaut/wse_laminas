<?php
/**
 * FAQ publique, modifiable dans GOD MODE > FAQ.
 * $items : FaqItem[] visibles, ou null si la table n'existe pas encore
 * (migration non jouee) : on affiche alors l'ancienne FAQ fixe.
 */
?>
<?php if ($items === null): ?>
    <?= $this->render('application/index/faq-static') ?>
<?php else: ?>
<div class='card'>
    <h3> Informations </h3>
    <?php if (empty($items)): ?>
        <p class="text-muted mb-0">Aucune question pour le moment.</p>
    <?php else: ?>
    <div class="accordion" id="faqAccordion">
        <?php foreach ($items as $item): ?>
            <?php $collapseId = 'faq' . $item->getId(); ?>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#<?= $collapseId ?>" aria-expanded="false" aria-controls="<?= $collapseId ?>">
                        <?= $this->escapeHtml($item->getQuestion()) ?>
                    </button>
                </h2>
                <div id="<?= $collapseId ?>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        <?php // HTML ecrit par le GOD (carte, tableau...) affiche tel quel ; texte simple echappe ?>
                        <?= $item->isHtml() ? $item->getAnswer() : nl2br($this->escapeHtml($item->getAnswer())) ?>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>
</div>
<?php endif; ?>
