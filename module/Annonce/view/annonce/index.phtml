<?= $this->partial('annonce/partial/header', ['active' => 'index']) ?>

<form method="get" action="<?= $this->escapeHtmlAttr($this->url('annonces')) ?>" class="card p-2 mb-3">
    <div class="d-flex flex-wrap" style="gap: .5rem;">
        <input type="search" name="q" class="form-control form-control-sm flex-grow-1" style="min-width: 10rem; flex-basis: 10rem;"
               placeholder="Rechercher…" value="<?= $this->escapeHtmlAttr($search) ?>" maxlength="100">
        <select name="tag" class="form-select form-select-sm" style="flex: 1 1 10rem;">
            <option value="">Toutes les catégories</option>
            <?php foreach ($tags as $tag): ?>
                <option value="<?= (int) $tag->getId() ?>" <?= $tagId === $tag->getId() ? 'selected' : '' ?>><?= $this->escapeHtml($tag->getLabel()) ?></option>
            <?php endforeach; ?>
        </select>
        <button type="submit" class="btn btn-sm btn-dark"><i class="fa-solid fa-magnifying-glass"></i><span class="visually-hidden">Rechercher</span></button>
        <?php if ($search !== '' || $tagId): ?>
            <a href="<?= $this->escapeHtmlAttr($this->url('annonces')) ?>" class="btn btn-sm btn-light" title="Effacer les filtres"><i class="fa-solid fa-xmark"></i></a>
        <?php endif; ?>
    </div>
</form>

<?php if (count($annonces) === 0): ?>
    <div class="card text-muted">
        <?= ($search !== '' || $tagId) ? 'Aucune annonce ne correspond à votre recherche.' : 'Aucune annonce pour le moment. Soyez le premier à publier !' ?>
    </div>
<?php else: ?>
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-2">
        <?php foreach ($annonces as $annonce): ?>
            <?php $cover = $annonce->getCoverPhoto(); ?>
            <div class="col">
                <a href="<?= $this->escapeHtmlAttr($this->url('annonces-view', ['id' => $annonce->getId()])) ?>" class="card annonce-card text-decoration-none text-dark mb-0">
                    <?php if ($cover): ?>
                        <img src="<?= $this->escapeHtmlAttr($this->url('annonces-photo', ['id' => $cover->getId()])) ?>" class="annonce-cover" alt="" loading="lazy">
                    <?php else: ?>
                        <div class="annonce-cover-empty"><i class="fa-regular fa-image"></i></div>
                    <?php endif; ?>
                    <div class="annonce-card-body">
                        <div class="annonce-card-title"><?= $this->escapeHtml($annonce->getTitle()) ?></div>
                        <div class="d-flex justify-content-between align-items-end mt-1" style="gap: .25rem;">
                            <?= $this->partial('annonce/partial/price', ['annonce' => $annonce]) ?>
                            <small class="text-muted"><?= $this->escapeHtml($annonce->getCreatedAt()->format('d/m')) ?></small>
                        </div>
                    </div>
                </a>
            </div>
        <?php endforeach; ?>
    </div>

    <?php if ($pages > 1): ?>
        <nav class="d-flex justify-content-center align-items-center mt-3" style="gap: .5rem;">
            <?php $query = array_filter(['q' => $search, 'tag' => $tagId]); ?>
            <a class="btn btn-sm btn-light <?= $page <= 1 ? 'disabled' : '' ?>"
               href="<?= $this->escapeHtmlAttr($this->url('annonces', [], ['query' => $query + ['page' => $page - 1]])) ?>">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <span class="badge bg-dark"><?= (int) $page ?> / <?= (int) $pages ?></span>
            <a class="btn btn-sm btn-light <?= $page >= $pages ? 'disabled' : '' ?>"
               href="<?= $this->escapeHtmlAttr($this->url('annonces', [], ['query' => $query + ['page' => $page + 1]])) ?>">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        </nav>
    <?php endif; ?>
<?php endif; ?>
