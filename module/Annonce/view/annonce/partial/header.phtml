        <i class="fa-solid fa-circle-info"></i>
    </button>
</div>

<script>
    (function () {
        var KEY = 'annonces-rappel-ferme';
        var DAYS = 30;
        var notice = document.getElementById('annonceNotice');
        var reopen = document.getElementById('annonceNoticeOpen');
        function show(visible) {
            notice.classList.toggle('d-none', !visible);
            reopen.classList.toggle('d-none', visible);
        }
        var closedAt = 0;
        try { closedAt = parseInt(localStorage.getItem(KEY) || '0', 10); } catch (e) { /* stockage indisponible : rappel affiche */ }
        show(!(closedAt && Date.now() - closedAt < DAYS * 86400000));
        document.getElementById('annonceNoticeClose').addEventListener('click', function () {
            try { localStorage.setItem(KEY, String(Date.now())); } catch (e) { /* rien */ }
            show(false);
        });
        reopen.addEventListener('click', function () {
            try { localStorage.removeItem(KEY); } catch (e) { /* rien */ }
            show(true);
        });
    })();
</script>
