<?= $this->partial('annonce-admin/partial/nav', ['active' => 'cgu']) ?>

<div class="card">
    <h4 class="mb-3">Conditions d'utilisation</h4>

    <?php if (!$history): ?>
        <div class="alert alert-danger small py-2">Aucune version publiée : l'espace est inaccessible tant qu'il n'y en a pas.</div>
    <?php else: ?>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Version</th><th>Publiée le</th><th class="text-end">Acceptations</th></tr></thead>
                <tbody>
                <?php foreach ($history as $row): ?>
                    <tr>
                        <td>
                            v<?= (int) $row['version']->getVersion() ?>
                            <?php if ($current && $row['version']->getId() === $current->getId()): ?>
                                <span class="badge bg-success">en vigueur</span>
                            <?php endif; ?>
                        </td>
                        <td><?= $this->escapeHtml($row['version']->getPublishedAt()->format('d/m/Y H:i')) ?></td>
                        <td class="text-end"><?= (int) $row['count'] ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>

<?php if ($acceptances): ?>
    <div class="card">
        <h5 class="mb-2">Dernières acceptations (version en vigueur)</h5>
        <div class="table-responsive">
            <table class="table table-sm small mb-0">
                <thead><tr><th>Utilisateur</th><th>Date</th><th>IP</th></tr></thead>
                <tbody>
                <?php foreach ($acceptances as $acceptance): ?>
                    <?php $member = $acceptance->getUser(); ?>
                    <tr>
                        <td class="text-break"><?= $this->escapeHtml(trim($member->getFirstname() . ' ' . $member->getLastname())) ?></td>
                        <td class="text-nowrap"><?= $this->escapeHtml($acceptance->getAcceptedAt()->format('d/m/Y H:i')) ?></td>
                        <td class="text-break"><?= $this->escapeHtml($acceptance->getIp()) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    </div>
<?php endif; ?>

<div class="card">
    <h5 class="mb-1">Publier une nouvelle version</h5>
    <p class="small text-muted">
        Texte en HTML (titres <code>&lt;h5&gt;</code>, paragraphes <code>&lt;p&gt;</code>, listes…). Une version publiée n'est plus
        modifiable : c'est la preuve de ce que les utilisateurs ont accepté. <strong>Tous les utilisateurs devront accepter la nouvelle version.</strong>
    </p>
    <form method="post" action="<?= $this->escapeHtmlAttr($this->url('admin-annonces-cgu')) ?>">
        <textarea name="content" class="form-control font-monospace small mb-3" rows="16" required><?= $current ? $this->escapeHtml($current->getContent()) : '' ?></textarea>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="confirm" value="1" id="confirmPublish" required>
            <label class="form-check-label small" for="confirmPublish">Je publie une nouvelle version : tous les utilisateurs devront l'accepter à nouveau.</label>
        </div>
        <button type="submit" class="btn btn-warning">Publier la version <?= $current ? $current->getVersion() + 1 : 1 ?></button>
    </form>
</div>
