<?php if (empty($users)): ?>
      <tr>
        <td colspan="3" class="text-center text-muted">Aucun utilisateur trouvé.</td>
      </tr>
<?php endif; ?>
<?php foreach ($users as $user): ?>
      <tr>
        <td>
          <?= $this->escapeHtml($user->getLastname()) ?>
          <div class="small text-muted"><?= $this->escapeHtml($user->getEmail()) ?></div>
        </td>
        <td><?= $this->escapeHtml($user->getFirstname()) ?></td>
        <td>
          <a href="<?= $this->escapeHtmlAttr($this->url('admin-edit-user', ['iduser' => $user->getIdUser()])) ?>" class="btn btn-sm btn-warning">
            <i class="fa-solid fa-edit"></i>
          </a>
        </td>
      </tr>
<?php endforeach; ?>
