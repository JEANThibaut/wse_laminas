<?php if (empty($users)): ?>
      <tr>
        <td colspan="2" class="text-center text-muted">Aucun utilisateur trouvé.</td>
      </tr>
<?php endif; ?>
<?php foreach ($users as $user): ?>
<?php
    // Inscriptions actives (member != 1) : presences (paid = 1) / inscriptions.
    // Les membres ne sont pas pointes : on affiche leur nombre d'inscriptions.
    $stat = $stats[$user->getIdUser()] ?? ['registered' => 0, 'validated' => 0, 'total' => 0];
    if ($user->getIsMember()) {
        $badgeText = $stat['total'] . ' inscr.';
        $badgeTitle = "Nombre d'inscriptions";
    } else {
        $badgeText = $stat['validated'] . '/' . $stat['registered'];
        $badgeTitle = 'Présences (payé) / inscriptions';
    }

    if ($user->getIsMember() || $stat['registered'] === 0) {
        $badgeClass = 'bg-secondary';
    } elseif ($stat['validated'] === $stat['registered']) {
        $badgeClass = 'bg-success';
    } elseif ($stat['validated'] === 0) {
        $badgeClass = 'bg-danger';
    } else {
        $badgeClass = 'bg-warning text-dark';
    }
?>
      <tr data-user-row>
        <td class="text-break">
          <div class="fw-semibold">
            <?= $this->escapeHtml($user->getLastname()) ?> <?= $this->escapeHtml($user->getFirstname()) ?><?= $this->mailCheck($user) ?>
            <span class="badge <?= $badgeClass ?> ms-1" title="<?= $this->escapeHtmlAttr($badgeTitle) ?>"><?= $this->escapeHtml($badgeText) ?></span>
          </div>
          <div class="small text-muted"><?= $this->escapeHtml($user->getEmail()) ?></div>
        </td>
        <td class="text-end align-middle" style="width: 1%;">
          <a href="<?= $this->escapeHtmlAttr($this->url('admin-edit-user', ['iduser' => $user->getIdUser()])) ?>" class="btn btn-sm btn-warning">
            <i class="fa-solid fa-edit"></i>
          </a>
        </td>
      </tr>
<?php endforeach; ?>
