        <script>
            // Choix du joueur affiche seulement pour "Un joueur"
            (function () {
                const target = document.getElementById('pushTarget');
                const field = document.getElementById('pushPlayerField');
                const toggle = () => field.classList.toggle('d-none', target.value !== 'player');
                target.addEventListener('change', toggle);
                toggle();
            })();
        </script>
    <?php endif; ?>
</div>
