            <?php endif; ?>
        </div>

        <form method="post">
            <div class="mb-3">
                <label for="pushTarget" class="form-label">Destinataires</label>
                <select name="target" id="pushTarget" class="form-select" required>
                    <?php foreach ($targets as $value => $label): ?>
                        <option value="<?= $this->escapeHtmlAttr($value) ?>"><?= $this->escapeHtml($label) ?></option>
                    <?php endforeach; ?>
                </select>
                <?php if ($nextGame): ?>
                    <div class="form-text">Prochaine partie : <?= $this->escapeHtml($nextGame->getDate()->format('d/m/Y')) ?></div>
                <?php endif; ?>
            </div>

            <div class="mb-3 d-none" id="pushPlayerField">
                <label for="pushPlayer" class="form-label">Joueur</label>
                <select name="user_id" id="pushPlayer" class="form-select">
                    <?php foreach ($players as $player): ?>
                        <option value="<?= $this->escapeHtmlAttr($player->getIdUser()) ?>">
                            <?= $this->escapeHtml($player->getLastname() . ' ' . $player->getFirstname()) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>

            <div class="mb-3">
                <label for="pushTitle" class="form-label">Titre</label>
                <input type="text" name="title" id="pushTitle" class="form-control" maxlength="<?= (int) $titleMax ?>" required
                       placeholder="Nouvelle partie ouverte !">
            </div>

            <div class="mb-3">
                <label for="pushBody" class="form-label">Message</label>
                <textarea name="body" id="pushBody" class="form-control" rows="3" maxlength="<?= (int) $bodyMax ?>" required
