// Icone et couleur par etat : l'etat se lit d'un coup d'oeil sur telephone
$stateIcons = [
    LoginLog::STATE_SUCCESS => 'fa-right-to-bracket text-success',
    LoginLog::STATE_SIGNUP => 'fa-user-plus text-primary',
    LoginLog::STATE_WRONG_PASSWORD => 'fa-key text-danger',
    LoginLog::STATE_UNKNOWN_EMAIL => 'fa-circle-question text-warning',
    LoginLog::STATE_LOGOUT => 'fa-right-from-bracket text-secondary',
];
$failureStates = [LoginLog::STATE_WRONG_PASSWORD, LoginLog::STATE_UNKNOWN_EMAIL];

$weekDays = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
$today = new \DateTimeImmutable('today');
$dayLabel = function (\DateTimeInterface $date) use ($today, $weekDays): string {
    $day = \DateTimeImmutable::createFromInterface($date)->setTime(0, 0);
    $diff = (int) $today->diff($day)->format('%a');
    if ($diff === 0) {
        return "Aujourd'hui";
    }
    if ($diff === 1) {
        return 'Hier';
    }
    return ucfirst($weekDays[(int) $day->format('w')]) . ' ' . $day->format('d/m');
};
$sinceLabel = function (\DateTimeInterface $date): string {
    $minutes = intdiv(time() - $date->getTimestamp(), 60);
    if ($minutes < 60) {
        return 'il y a ' . max(1, $minutes) . ' min';
    }
    if ($minutes < 24 * 60) {
        return 'il y a ' . intdiv($minutes, 60) . ' h';
    }
    $days = intdiv($minutes, 24 * 60);
    return $days < 30 ? 'il y a ' . $days . ' j' : 'le ' . $date->format('d/m/Y');
};

// Regroupement par jour, du plus recent au plus ancien (les logs arrivent deja tries)
