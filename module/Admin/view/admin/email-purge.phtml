<div class="card">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-2" style="gap: 0.5rem;">
        <h4 class="mb-0">Purge emails</h4>
        <a href="<?= $this->escapeHtmlAttr($this->url('admin-email-domains')) ?>" class="btn btn-sm btn-outline-dark">
            <i class="fa-solid fa-ban me-1"></i>Emails interdits
        </a>
    </div>
    <p class="small text-muted">
        Comptes dont l'adresse est sur un domaine interdit. La purge garde le compte mais le
        <b>désactive</b>, le <b>désinscrit des parties à venir</b> et le retire des files d'attente,
        sans le prévenir. Les parties passées ne sont pas touchées ; votre compte n'est jamais concerné.
    </p>

    <?php if (empty($candidates)): ?>
        <p class="text-success mb-0"><i class="fa-solid fa-check me-1"></i>Aucun compte à purger.</p>
    <?php else: ?>
        <div class="list-group mb-3">
            <?php foreach ($candidates as ['user' => $user, 'registers' => $registers, 'entries' => $entries]): ?>
                <div class="list-group-item px-2 py-2 text-break">
                    <div class="fw-semibold">
                        <?= $this->escapeHtml($user->getFirstname() . ' ' . $user->getLastname()) ?>
                        <?php if ($user->hasAdminAccess()): ?><span class="badge text-bg-warning">admin</span><?php endif; ?>
                    </div>
                    <div class="small text-muted"><?= $this->escapeHtml($user->getEmail()) ?></div>
                    <div class="small">
                        <?= !$user->isDeactivated() ? 'Compte actif' : '<span class="text-muted">Déjà désactivé</span>' ?>
                        <?php foreach ($registers as $register): ?>
                            · inscrit le <?= $this->escapeHtml($register->getGame()->getDate()->format('d/m/Y')) ?>
                        <?php endforeach; ?>
                        <?php foreach ($entries as $entry): ?>
                            · en file le <?= $this->escapeHtml($entry->getGame()->getDate()->format('d/m/Y')) ?>
                        <?php endforeach; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        <form method="post" action="<?= $this->escapeHtmlAttr($this->url('admin-email-purge')) ?>">
            <button type="submit" class="btn btn-danger w-100"
                    onclick="return confirm('Désactiver ces <?= count($candidates) ?> compte(s) et les désinscrire des parties à venir ?');">
                <i class="fa-solid fa-broom me-1"></i>Purger <?= count($candidates) ?> compte<?= count($candidates) > 1 ? 's' : '' ?>
            </button>
        </form>
    <?php endif; ?>
</div>
